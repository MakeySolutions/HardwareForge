{
  "name": "hardwareforge",
  "productName": "HardwareForge",
  "version": "0.1.1",
  "description": "Plánovanie hardvérových projektov (ESP32, Arduino, 3D tlač) — všetko lokálne na tvojom počítači.",
  "private": true,
  "license": "MIT",
  "author": "HardwareForge",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1",
    "build:next": "next build --webpack && node scripts/clean-standalone.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "electron": "npm run build:next && npm run build:electron && electron .",
    "dist": "npm run build:next && npm run build:electron && electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migration": "node scripts/new-migration.mjs",
    "postinstall": "prisma generate && node scripts/copy-excalidraw-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "libsql": "^0.5.29",
    "lucide-react": "^1.33.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "electron@44.3.0": true
  },
  "overrides": {
    "nanoid": "3.3.18",
    "lodash-es": "^4.18.1",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "3.3.18"
    }
  }
}
